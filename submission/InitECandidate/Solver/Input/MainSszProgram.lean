def guard : ProgHOL 64 := .ite (.cmp .notEqual (.var .global (ofString "zero_hashes")) (.const 0#64)) (.return (.const 0#64)) .skip
def tableStores : ProgHOL 64 := InitializerWords.stores "zero_hashes" 0 words (.return (.const 0#64))
def afterGuard : ProgHOL 64 := InitializerAllocations.withTail actions tableStores

theorem body_shape : body = .seq guard afterGuard := by
  simp only [body,guard,afterGuard,actions,tableStores,words,InitializerAllocations.withTail,InitializerAllocations.call,InitializerAllocations.constant,
    InitializerWords.stores,Guest.guestFn_ssz_init,progToHOL,expToHOL,shapeToHOL,List.map_cons,List.map_nil,Option.map_some,Option.map_none]

theorem words_length : words.length = 256 := by decide_cbv

theorem valid : ∀ action,action ∈ actions → InitializerAllocations.Valid action := by
  intro action member
  simp only [actions,List.mem_cons,List.not_mem_nil,or_false] at member
  rcases member with rfl | rfl | rfl
  · exact InitializerAllocations.valid_constant "ssz_len_chunk" 32 OriginalScalarGlobals.ssz_names.1 (by decide) (by decide)
  · exact InitializerAllocations.valid_constant "ssz_offs" 64 OriginalScalarGlobals.ssz_names.2.1 (by decide) (by decide)
  · exact ⟨OriginalScalarGlobals.ssz_names.2.2,by decide,by decide,fun _ => rfl⟩

theorem original_code (code) (installed : OriginalCode.Installed code) : code.lookup (ofString "ssz_init") = some ([],body,.one) := by
  have checked := OriginalCode.indexed code installed 174 (GasBudget.OriginalCodeEnvironment.originalEntry Guest.guestFn_ssz_init) (by rfl)
  simpa only [GasBudget.OriginalCodeEnvironment.originalEntry,declToHOL,funDeclToHOL,body,Guest.guestFn_ssz_init,shapeToHOL,List.map_cons,List.map_nil] using checked

