#include "config.h"
#include "types.h"
#include "lib/mem.pnk"
#include "lib/htab.pnk"
#include "lib/keccak.pnk"
#include "witness-radix.pnk"

/* kind 0: byte keys; 1: all duplicates; 2: last-byte keys; 3: repeated keys.
   This tests the actual candidate routines, not a separate map implementation. */
fun 1 radix_unit_key(1 out, 1 ordinal, 1 kind) {
  st out, 0;
  st out + 8, 0;
  st out + 16, 0;
  st out + 24, 0;
  if kind == 0 { st out, ordinal; }
  if kind == 1 { st out, 123456; }
  if kind == 2 { st out + 24, ordinal << 56; }
  if kind == 3 { st out, ordinal & 7; }
  return 0;
}

fun 1 radix_unit_case(1 n, 1 kind) {
  var cap = 4;
  while cap <+ n * 2 + 2 { cap = cap * 2; }
  var 1 t = htab_new(32, cap);
  var keys = lds 1 (t + 32);
  var vals = lds 1 (t + 40);
  var order = lds 1 (t + 56);
  var 1 records = alloc(n * 16);
  var i = 0;
  while i <+ n {
    radix_unit_key(keys + i * 32, i, kind);
    st records + i * 16, i;
    st records + i * 16 + 8, 42;
    st vals + i * 8, records + i * 16;
    st order + i * 8, i;
    i = i + 1;
  }
  solver_radix_index(t, n);
  i = 0;
  while i <+ n {
    radix_unit_key(mpt_hash_scratch, i, kind);
    var {1,1,1} r = nodedb_lookup(t, mpt_hash_scratch);
    var expected = i;
    if kind == 1 { expected = n - 1; }
    if kind == 3 {
      var j = i;
      while j <+ n { expected = j; j = j + 8; }
    }
    if (r.0 != 1) || (r.1 != expected) || (r.2 != 42) { trap_with(90); }
    i = i + 1;
  }
  st mpt_hash_scratch, 255;
  st mpt_hash_scratch + 8, 0;
  st mpt_hash_scratch + 16, 0;
  st mpt_hash_scratch + 24, 0;
  var {1,1,1} absent = nodedb_lookup(t, mpt_hash_scratch);
  if (absent.0 != 0) || (absent.1 != 0) || (absent.2 != 0) { trap_with(91); }
  return 0;
}

fun 1 main() {
  mem_init();
  mpt_hash_scratch = alloc(32);
  radix_unit_case(0, 0);
  radix_unit_case(1, 0);
  radix_unit_case(2, 2);
  radix_unit_case(12, 1);
  radix_unit_case(40, 0);
  radix_unit_case(24, 2);
  radix_unit_case(48, 3);
  !st8 OUTPUT_ADDR + 32, 1;
  @halt(@base, 0, @base, 0);
  return 0;
}
