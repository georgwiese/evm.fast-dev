/* Source for candidate-only replacement AST declarations. This is not the
   fixed source and is not yet a certified refinement. Includes no allocator
   changes: htab_new reserves the baseline arrays in the baseline order. */
#include "config.h"
#include "types.h"

/* Needed by the parser to classify this reference as a global. The generated
   candidate keeps the original declaration, not this scaffolding initializer. */
var 1 mpt_hash_scratch = 0;

/* Header offsets are identical to lib/htab.pnk. HT_COUNT (24) becomes root.
   Root 0 is empty, odd roots encode a leaf ordinal, even roots are branch
   addresses. Each branch is <bit-index, zero-child, one-child>, 24 bytes.
   Original key storage holds N hashes, then at most N-1 branch records.
   The first N words of order/order_pos are partition buffers; their tails
   and the vals tail hold three parallel arrays of pending right subtrees. */
fun 1 solver_radix_index(1 t, 1 n) {
  var keys = lds 1 (t + 32);
  var vals = lds 1 (t + 40);
  var src = lds 1 (t + 56);
  var dst = lds 1 (t + 64);
  var pending_start = src + n * 8;
  var pending_count = dst + n * 8;
  var pending_node = vals + n * 8;
  var node_next = keys + n * 32;
  var dest = t + 24;
  var start = 0;
  var count = n;
  var bit = 0;
  var depth = 0;
  if n == 0 {
    st dest, 0;
    return 0;
  }
  while true {
    if (count == 1) || (bit == 256) {
      var ordinal = lds 1 (src + (start + count - 1) * 8);
      st dest, ordinal * 2 + 1;
      if depth == 0 { return 0; }
      depth = depth - 1;
      start = lds 1 (pending_start + depth * 8);
      count = lds 1 (pending_count + depth * 8);
      var parent = lds 1 (pending_node + depth * 8);
      bit = (lds 1 parent) + 1;
      dest = parent + 16;
      continue;
    }
    var zeros = 0;
    var i = 0;
    while i <+ count {
      var ordinal = lds 1 (src + (start + i) * 8);
      var digit = ((ld8 (keys + ordinal * 32 + (bit >>> 3))) >>> (bit & 7)) & 1;
      if digit == 0 { zeros = zeros + 1; }
      i = i + 1;
    }
    if (zeros == 0) || (zeros == count) {
      bit = bit + 1;
      continue;
    }
    var zero_cursor = start;
    var one_cursor = start + zeros;
    i = 0;
    while i <+ count {
      var ordinal = lds 1 (src + (start + i) * 8);
      var digit = ((ld8 (keys + ordinal * 32 + (bit >>> 3))) >>> (bit & 7)) & 1;
      if digit == 0 {
        st dst + zero_cursor * 8, ordinal;
        zero_cursor = zero_cursor + 1;
      } else {
        st dst + one_cursor * 8, ordinal;
        one_cursor = one_cursor + 1;
      }
      i = i + 1;
    }
    i = 0;
    while i <+ count {
      st src + (start + i) * 8, lds 1 (dst + (start + i) * 8);
      i = i + 1;
    }
    var node = node_next;
    node_next = node_next + 24;
    st node, bit;
    st node + 8, 0;
    st node + 16, 0;
    st dest, node;
    st pending_start + depth * 8, start + zeros;
    st pending_count + depth * 8, count - zeros;
    st pending_node + depth * 8, node;
    depth = depth + 1;
    count = zeros;
    dest = node + 8;
    bit = bit + 1;
  }
  return 0;
}

fun 1 nodedb_build(1 slice_arr, 1 n) {
  var cap = 4;
  while cap <+ 2 * n + 2 { cap = cap * 2; }
  var 1 t = htab_new(32, cap);
  var keys = lds 1 (t + 32);
  var vals = lds 1 (t + 40);
  var order = lds 1 (t + 56);
  var i = 0;
  while i <+ n {
    keccak256(SLICE_PTR(slice_arr, i), SLICE_LEN(slice_arr, i), mpt_hash_scratch);
    memcpy(keys + i * 32, mpt_hash_scratch, 32);
    st vals + i * 8, slice_arr + i * 16;
    st order + i * 8, i;
    i = i + 1;
  }
  solver_radix_index(t, n);
  return t;
}

fun {1,1,1} nodedb_lookup(1 db, 1 hash) {
  var node = lds 1 (db + 24);
  while node != 0 {
    if (node & 1) != 0 {
      var ordinal = node >>> 1;
      var keys = lds 1 (db + 32);
      var 1 equal = memeq(keys + ordinal * 32, hash, 32);
      if equal == 0 { return <0, 0, 0>; }
      var record = lds 1 ((lds 1 (db + 40)) + ordinal * 8);
      return <1, lds 1 record, lds 1 (record + 8)>;
    }
    var bit = lds 1 node;
    var digit = ((ld8 (hash + (bit >>> 3))) >>> (bit & 7)) & 1;
    if digit == 0 { node = lds 1 (node + 8); }
    else { node = lds 1 (node + 16); }
  }
  return <0, 0, 0>;
}
